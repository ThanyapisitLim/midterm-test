{
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.4",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "concurrently": "^10.0.7",
    "nodemon": "^3.1.14",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "name": "qr-attendance",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n server,css -c blue,magenta \"nodemon\" \"npm:css\"",
    "css": "tailwindcss -i ./styles/app.css -o ./public/output.css --watch=always",
    "css:build": "tailwindcss -i ./styles/app.css -o ./public/output.css --minify",
    "build": "npm run css:build && tsc",
    "start": "node --env-file-if-exists=.env.local dist/index.js"
  }
}
