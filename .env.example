# คัดลอกเป็น .env.local แล้วเติมค่า (ห้าม commit .env.local)

# connection string จาก Neon Console (ใช้แบบ pooled คือ host มี -pooler)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# สุ่มด้วย: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# อายุ token เป็นวินาที (access 15 นาที, refresh 7 วัน)
ACCESS_TOKEN_SECONDS=900
REFRESH_TOKEN_SECONDS=604800

# ความแรงของการ hash รหัสผ่าน (ยิ่งสูงยิ่งช้า) / ความยาวโค้ดเข้าห้องเรียน / จำนวน connection สูงสุดไป DB
BCRYPT_ROUNDS=10
JOIN_CODE_LENGTH=6
DB_POOL_MAX=5

# การเช็คชื่อ: รอก่อนเริ่มโชว์รหัสแรก / ช่วงโชว์รหัสแต่ละตัว / ระยะเวลาทั้งคาบ (วินาที)
CHECKIN_START_DELAY_SECONDS=3
CHECKIN_CODE_SECONDS=15
CHECKIN_DURATION_SECONDS=180
# ผ่อนผันหลังรหัสหมดอายุ (กันเน็ตช้า/พิมพ์ช้า) และความยาวรหัส
CHECKIN_GRACE_SECONDS=10
CHECKIN_CODE_LENGTH=6
