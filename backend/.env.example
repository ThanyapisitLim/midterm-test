# คัดลอกไฟล์นี้เป็น .env.local แล้วเติมค่า (ห้าม commit .env.local)

# ---- Neon (ได้จาก `npx neon@latest env pull` หรือ `neon deploy`) ----
# แบบ pooled (host มี -pooler) ใช้กับแอป
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# แบบ direct ใช้ตอน migrate
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require
NEON_BRANCH=production
NEON_BRANCH_ID=
NEON_FUNCTION_HOST_SUFFIX=

# ---- แอป ----
# สุ่มสร้างด้วย: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# URL หน้าเว็บที่ใส่ใน QR (ตอน deploy = URL ของ frontend)
APP_URL=http://localhost:3000
# QR หมดอายุภายในกี่วินาที
QR_TTL_SECONDS=15
# ผ่อนผันหลังหมดอายุกี่วินาที (กันเน็ตช้า) เกินนี้ถือว่าสงสัยส่ง QR ต่อ
QR_GRACE_SECONDS=5
