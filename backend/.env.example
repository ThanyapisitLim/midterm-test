# คัดลอกเป็น .env.local แล้วเติมค่า (ห้าม commit .env.local)

# จาก `npx neon@latest env pull`
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require
NEON_BRANCH=production
NEON_BRANCH_ID=
NEON_FUNCTION_HOST_SUFFIX=

# สุ่มด้วย: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

APP_URL=http://localhost:8000
QR_TTL_SECONDS=15
QR_GRACE_SECONDS=5
