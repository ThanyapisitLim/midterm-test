<%- include('../partials/head', { title }) %>
<body class="min-h-dvh bg-zinc-50 font-sans text-zinc-900">
  <%- include('../partials/navbar', { user }) %>

  <main class="mx-auto max-w-5xl space-y-8 px-4 py-8">
    <a href="/teacher" class="inline-block text-sm text-zinc-500 transition hover:text-zinc-900">← ห้องเรียนทั้งหมด</a>

    <div class="flex items-start justify-between gap-4">
      <div>
        <p class="text-xs text-swu-grey">ห้องเรียน</p>
        <h1 class="mt-1 text-2xl font-semibold"><%= classroom.name %></h1>
      </div>
      <div class="shrink-0 text-right">
        <p class="text-xs text-zinc-500">โค้ดเข้าห้อง</p>
        <% if (classroom.join_code) { %>
        <p class="mt-0.5 font-mono text-lg tracking-widest text-zinc-700"><%= classroom.join_code %></p>
        <% } else { %>
        <button id="generate-btn" type="button"
          class="mt-0.5 text-sm text-swu-grey underline underline-offset-4 transition hover:text-zinc-900 disabled:opacity-50">
          สร้างโค้ด
        </button>
        <% } %>
        <p id="code-error" class="mt-1 text-xs text-red-600"></p>
      </div>
    </div>

    <section class="rounded-xl border border-zinc-200 bg-white p-6">
      <button id="start-btn" type="button"
        class="w-full rounded-xl bg-swu-red px-8 py-4 text-base font-semibold text-white transition hover:bg-swu-red-dark focus-visible:ring-2 focus-visible:ring-swu-red/40 focus-visible:outline-none disabled:cursor-not-allowed disabled:opacity-50 sm:w-auto">
        เริ่มเช็คชื่อวันนี้
      </button>
      <p class="mt-3 text-sm text-zinc-500">แสดงรหัส 6 หลักที่เปลี่ยนทุก 15 วินาที ให้นิสิตกรอกรหัสบนจอเพื่อเช็คชื่อ</p>
      <p id="start-error" class="mt-1.5 text-xs text-red-600"></p>
    </section>

    <section>
      <h2 class="mb-3 font-medium">นิสิตในห้อง <span class="text-zinc-500">(<%= students.length %>)</span></h2>
      <div class="overflow-x-auto rounded-xl border border-zinc-200">
        <table class="w-full text-left text-sm">
          <thead class="border-b border-zinc-200 bg-white text-zinc-500">
            <tr>
              <th class="px-4 py-3 font-medium">รหัสนักศึกษา</th>
              <th class="px-4 py-3 font-medium">ชื่อ-นามสกุล</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-zinc-200">
            <% for (const s of students) { %>
            <tr>
              <td class="px-4 py-3 font-mono"><%= s.student_code %></td>
              <td class="px-4 py-3"><%= s.full_name %></td>
            </tr>
            <% } %>
          </tbody>
        </table>
      </div>
      <% if (students.length === 0) { %>
      <p class="mt-3 text-center text-sm text-zinc-500">
        ยังไม่มีนิสิตในห้องนี้ สร้างโค้ดเข้าห้องแล้วให้นิสิตกรอกที่หน้าหลัก
      </p>
      <% } %>
    </section>
  </main>

  <div id="checkin-modal" class="fixed inset-0 z-50 hidden items-center justify-center overflow-y-auto bg-black/50 p-4" role="dialog" aria-modal="true" aria-label="เช็คชื่อ">
    <div class="w-full max-w-2xl rounded-2xl border border-zinc-200 bg-white p-6 text-center shadow-2xl sm:p-8">
      <div id="view-waiting" class="hidden py-8">
        <p class="text-zinc-500">เตรียมเริ่มเช็คชื่อ</p>
        <p id="waiting-left" class="mt-4 text-9xl font-semibold tabular-nums">3</p>
      </div>

      <div id="view-showing" class="hidden">
        <p class="text-sm text-zinc-500">รอบที่ <span id="round">1</span> / <span id="total">12</span></p>
        <p id="code" class="mt-4 font-mono text-5xl font-semibold tracking-[0.2em] tabular-nums sm:text-8xl">000 000</p>
        <div class="mt-8 h-3 overflow-hidden rounded-full bg-zinc-200">
          <div id="bar" class="h-full w-full rounded-full bg-swu-red"></div>
        </div>
        <p class="mt-3 text-2xl font-semibold tabular-nums"><span id="code-left">15</span> วินาที</p>
        <p class="mt-5 text-sm text-zinc-500">
          เหลือเวลาทั้งหมด <span id="total-left" class="tabular-nums text-zinc-800">0:00</span>
          · ส่งรหัสแล้ว <span id="submitted" class="tabular-nums text-zinc-800">0</span> / <span id="students" class="tabular-nums">0</span> คน
        </p>
      </div>

      <div id="view-closing" class="hidden py-8">
        <p class="text-lg">รหัสสุดท้ายหมดแล้ว</p>
        <p class="mt-2 text-sm text-zinc-500">รอนิสิตที่ส่งรหัสช้า อีก <span id="closing-left" class="tabular-nums text-zinc-800">10</span> วินาที แล้วจะสรุปผล</p>
      </div>

      <div id="view-result" class="hidden text-left">
        <h2 class="text-center text-xl font-semibold">ผลการเช็คชื่อ</h2>
        <div class="mt-5 grid grid-cols-3 gap-3 text-center">
          <div class="rounded-xl bg-emerald-50 p-3 ring-1 ring-emerald-200">
            <p class="text-xs text-emerald-800">มาเรียน</p>
            <p id="sum-present" class="mt-1 text-2xl font-semibold tabular-nums text-emerald-700">0</p>
          </div>
          <div class="rounded-xl bg-amber-50 p-3 ring-1 ring-amber-200">
            <p class="text-xs text-amber-800">ส่งเลท</p>
            <p id="sum-suspicious" class="mt-1 text-2xl font-semibold tabular-nums text-amber-700">0</p>
          </div>
          <div class="rounded-xl bg-zinc-100 p-3 ring-1 ring-zinc-300">
            <p class="text-xs text-zinc-500">ขาด</p>
            <p id="sum-absent" class="mt-1 text-2xl font-semibold tabular-nums text-zinc-700">0</p>
          </div>
        </div>
        <div class="mt-5 max-h-80 overflow-y-auto rounded-xl border border-zinc-200">
          <table class="w-full text-left text-sm">
            <thead class="sticky top-0 border-b border-zinc-200 bg-white text-zinc-500">
              <tr>
                <th class="px-4 py-3 font-medium">รหัสนักศึกษา</th>
                <th class="px-4 py-3 font-medium">ชื่อ-นามสกุล</th>
                <th class="px-4 py-3 font-medium">ผล</th>
              </tr>
            </thead>
            <tbody id="result-rows" class="divide-y divide-zinc-200"></tbody>
          </table>
        </div>
        <p id="result-empty" class="mt-3 hidden text-center text-sm text-zinc-500">ยังไม่มีนิสิตในห้องนี้</p>
      </div>

      <div id="view-error" class="hidden py-8">
        <p id="error-text" class="text-red-600"></p>
      </div>

      <div class="mt-8 flex justify-center gap-3">
        <button id="finish-btn" type="button"
          class="rounded-lg px-5 py-2.5 text-sm text-zinc-700 ring-1 ring-zinc-300 transition hover:bg-zinc-100">
          จบเช็คชื่อตอนนี้
        </button>
        <button id="close-btn" type="button"
          class="hidden rounded-lg bg-swu-red px-6 py-2.5 text-sm font-medium text-white transition hover:bg-swu-red-dark">
          ปิด
        </button>
      </div>
    </div>
  </div>

  <script type="module" src="/script/teacher-classroom.js"></script>
</body>
</html>
