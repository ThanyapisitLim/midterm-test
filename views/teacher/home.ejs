<%- include('../partials/head', { title }) %>
<body class="min-h-dvh bg-zinc-50 font-sans text-zinc-900">
  <%- include('../partials/navbar', { user }) %>

  <main class="mx-auto max-w-5xl space-y-8 px-4 py-8">
    <div>
      <p class="text-xs text-swu-grey">อาจารย์</p>
      <h1 class="mt-1 text-2xl font-semibold">ห้องเรียนของฉัน</h1>
    </div>

    <section>
      <form id="create-form" class="flex flex-col gap-3 sm:flex-row" novalidate>
        <label for="name" class="sr-only">ชื่อห้องเรียน</label>
        <input id="name" name="name" maxlength="100" placeholder="ชื่อห้องเรียน เช่น Web Programming ศ.บ่าย"
          class="block w-full rounded-lg border border-zinc-300 bg-white px-4 py-2.5 text-sm text-zinc-900 placeholder:text-zinc-400 focus:border-swu-red focus:ring-2 focus:ring-swu-red/30 focus:outline-none aria-invalid:border-red-500">
        <button id="create-btn" type="submit"
          class="shrink-0 rounded-lg bg-swu-red px-5 py-2.5 text-sm font-medium text-white transition hover:bg-swu-red-dark focus-visible:ring-2 focus-visible:ring-swu-red/40 focus-visible:outline-none disabled:cursor-not-allowed disabled:opacity-50">
          สร้างห้องเรียน
        </button>
      </form>
      <p id="create-error" class="mt-1.5 text-xs text-red-600"></p>
    </section>

    <% if (classrooms.length > 0) { %>
    <section class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <% for (const c of classrooms) { %>
      <a href="/teacher/classroom?id=<%= c.id %>"
        class="group block rounded-xl border border-zinc-200 bg-white p-5 transition hover:border-swu-red/60">
        <h2 class="font-medium"><%= c.name %></h2>
        <p class="mt-1 text-sm text-zinc-500"><%= c.student_count %> นิสิต</p>
        <span class="mt-4 inline-block text-sm text-swu-grey transition group-hover:text-zinc-900">เข้าห้องเรียน →</span>
      </a>
      <% } %>
    </section>
    <% } else { %>
    <p class="rounded-xl border border-dashed border-zinc-300 px-4 py-10 text-center text-sm text-zinc-500">
      ยังไม่มีห้องเรียน สร้างห้องแรกได้จากช่องด้านบน
    </p>
    <% } %>
  </main>

  <script type="module" src="/script/teacher-home.js"></script>
</body>
</html>
